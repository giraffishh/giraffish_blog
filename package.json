{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node build-tools/prepare-renderer.cjs && npm run build:admin && node build-tools/build-site.cjs",
    "build:admin": "npm --prefix admin-app ci --include=dev --ignore-scripts --no-fund --no-audit && npm --prefix admin-app test && npm --prefix admin-app run build",
    "test:admin": "npm --prefix admin-app test",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "overrides": {
    "hexo-renderer-markdown-it": { "markdown-it": "15.0.3" },
    "katex": "0.19.1"
  },
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "hexo": "^8.1.2",
    "hexo-abbrlink": "^2.2.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-fluid": "^1.9.9",
    "hexo-theme-landscape": "^1.1.0"
  }
}
