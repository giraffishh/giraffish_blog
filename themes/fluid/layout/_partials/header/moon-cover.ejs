<div id="banner" class="banner moon-cover">
  <div class="cozy-art">
    <svg class="moon-landscape" viewBox="0 0 900 760" preserveAspectRatio="xMidYMid meet" role="group" aria-label="窗边小屋，可点击落地灯和猫咪">
      <desc>一扇拱窗，一杯热茶，书本旁睡着一只猫。白天阳光照进房间，夜晚灯下有柔软的月色。</desc>
      <defs>
        <clipPath id="cozy-window"><path d="M304 482V225a163 163 0 0 1 326 0v257Z"/></clipPath>
        <radialGradient id="cozy-lamplight"><stop stop-color="#ffdca4" stop-opacity=".28"/><stop offset="1" stop-color="#ffce88" stop-opacity="0"/></radialGradient>
        <linearGradient id="cozy-glass" x2="0" y2="1"><stop stop-color="var(--window-top)"/><stop offset="1" stop-color="var(--window-bottom)"/></linearGradient>
        <linearGradient id="cozy-sunlight" x2=".4" y2="1"><stop stop-color="#fff2c8" stop-opacity=".38"/><stop offset="1" stop-color="#fff2c8" stop-opacity="0"/></linearGradient>
      </defs>
      <!-- A soft arch and a quiet floor make a room without outlining it. -->
      <path d="M197 554V233a267 267 0 0 1 534 0v321Z" fill="var(--wall-inset)"/>
      <ellipse cx="478" cy="674" rx="366" ry="39" fill="var(--floor-shadow)"/>
      <ellipse cx="463" cy="671" rx="264" ry="29" fill="var(--rug)"/>
      <path d="M274 484V222a191 191 0 0 1 382 0v262Z" fill="var(--frame-shadow)"/>
      <path d="M289 482V225a178 178 0 0 1 356 0v257Z" fill="var(--frame)"/>
      <g clip-path="url(#cozy-window)">
        <path d="M302 48H632V485H302Z" fill="url(#cozy-glass)"/>
        <g class="cozy-day">
          <circle class="cozy-sun-halo" cx="543" cy="154" r="53" fill="#fff3c9" opacity=".35"/>
          <circle cx="543" cy="154" r="30" fill="#ffefbf"/>
          <g class="cozy-cloud" fill="#f9faf1" opacity=".88">
            <path d="M294 220a20 20 0 0 1 21-19a29 29 0 0 1 55-10a21 21 0 0 1 30 21h18a11 11 0 0 1 0 22H303a9 9 0 0 1-9-14Z"/>
            <path d="M527 263a17 17 0 0 1 17-17a23 23 0 0 1 43-5a18 18 0 0 1 27 17h16a9 9 0 0 1 0 18h-94a9 9 0 0 1-9-13Z"/>
          </g>
          <g class="cozy-bird-flight"><path class="cozy-bird-wings" d="M421 169q7-7 14 0q7-7 14 0" fill="none" stroke="#7c9e96" stroke-width="2.5" stroke-linecap="round"/></g>
        </g>
        <g class="cozy-night">
          <path d="M548 118a31 31 0 1 0 30 43a29 29 0 0 1-30-43Z" fill="#f7e9b6"/>
          <g class="cozy-shooting-star" fill="none" stroke="#f9efce" stroke-linecap="round"><path d="M567 176l25-17" stroke-width="1.2"/><circle cx="567" cy="176" r="1.6" fill="#f9efce" stroke="none"/></g>
          <g class="cozy-stars" fill="#f6ebc9">
            <circle cx="354" cy="158" r="1.8"/><circle cx="411" cy="108" r="1.4"/><circle cx="493" cy="195" r="1.5"/><circle cx="593" cy="206" r="1.7"/><circle cx="397" cy="244" r="1.6"/><circle cx="562" cy="288" r="1.4"/>
            <path d="M439 195l2 5 5 2-5 2-2 5-2-5-5-2 5-2Z"/>
            <path d="M591 121l1.5 4 4 1.5-4 1.5-1.5 4-1.5-4-4-1.5 4-1.5Z"/>
          </g>
        </g>
        <path d="M280 387Q364 284 455 349T658 315V490H280Z" fill="var(--hill-back)"/>
        <path d="M280 423Q417 334 516 414T655 370V490H280Z" fill="var(--hill-front)"/>
        <path d="M366 483Q455 424 495 454T616 447" fill="none" stroke="var(--hill-path)" stroke-width="13" opacity=".55"/>
        <g fill="var(--tree)"><rect x="581" y="361" width="5" height="77" rx="2"/><ellipse cx="584" cy="353" rx="25" ry="42"/><rect x="337" y="389" width="4" height="61" rx="2"/><ellipse cx="339" cy="385" rx="18" ry="32"/></g>
      </g>
      <path d="M467 66V482M304 306H630" stroke="var(--frame)" stroke-width="12"/>
      <rect x="276" y="482" width="383" height="18" rx="6" fill="var(--sill)"/>
      <rect x="289" y="482" width="358" height="5" rx="2" fill="var(--frame)"/>
      <!-- Small curtains frame the window, with rounded folds. -->
      <g class="cozy-curtain cozy-curtain-left">
      <path d="M270 77Q288 93 314 87L308 320Q298 369 287 474H251Q279 339 271 247Z" fill="var(--curtain)"/>
      <path d="M275 111Q286 267 266 435" fill="none" stroke="var(--curtain-fold)" stroke-width="6" stroke-linecap="round"/>
      </g>
      <g class="cozy-curtain cozy-curtain-right">
      <path d="M639 85Q658 87 670 74L670 261Q665 373 697 474H651Q635 371 633 320Z" fill="var(--curtain)"/>
      <path d="M657 112Q646 296 679 437" fill="none" stroke="var(--curtain-fold)" stroke-width="6" stroke-linecap="round"/>
      </g>
      <path class="cozy-day" d="M316 492H623L786 670H456Z" fill="url(#cozy-sunlight)"/>
      <!-- A picture on the wall. -->
      <rect x="136" y="225" width="86" height="112" rx="6" fill="var(--wood)"/>
      <rect x="143" y="232" width="72" height="98" rx="3" fill="var(--paper)"/>
      <circle cx="179" cy="259" r="12" fill="var(--room-accent)" opacity=".65"/>
      <path d="M153 314V296Q163 278 178 296Q194 272 206 292V314Z" fill="var(--leaf-light)"/>
      <!-- A floor lamp: softly lit only at night. -->
      <g class="cozy-lamp" role="button" tabindex="0" aria-label="落地灯：切换白天与黑夜" aria-pressed="false">
      <circle class="cozy-night cozy-lamp-glow" cx="734" cy="350" r="153" fill="url(#cozy-lamplight)"/>
      <ellipse cx="740" cy="668" rx="49" ry="9" fill="var(--floor-shadow)"/>
      <rect x="734" y="351" width="8" height="307" rx="4" fill="var(--lamp-metal)"/>
      <path d="M713 647h49a15 15 0 0 1 15 15h-79a15 15 0 0 1 15-15Z" fill="var(--lamp-metal)"/>
      <path class="cozy-lamp-shade" d="M700 271h73l30 83H672Z" fill="var(--lamp-shade)"/>
      <ellipse cx="738" cy="354" rx="66" ry="10" fill="var(--lamp-bottom)"/>
      <ellipse class="cozy-night" cx="738" cy="355" rx="43" ry="6" fill="#ffe5ab"/>
      <path d="M719 280L702 343M735 280v62M752 280l19 63" stroke="var(--lamp-fold)" stroke-width="2" opacity=".4"/>
      <rect class="cozy-hit" x="663" y="258" width="149" height="410" rx="18"/>
      </g>
      <g class="cozy-night" fill="#f5d29b">
        <circle class="cozy-mote" cx="686" cy="389" r="1.7"/>
        <circle class="cozy-mote" cx="758" cy="420" r="1.4" style="animation-delay:-3s"/>
        <circle class="cozy-mote" cx="708" cy="464" r="1.2" style="animation-delay:-6s"/>
        <circle class="cozy-mote" cx="784" cy="379" r="1.3" style="animation-delay:-8s"/>
      </g>
      <!-- A little desk, books, tea, and a napping companion. -->
      <path d="M313 556L294 661h17l30-105M614 556l28 105h17l-18-105" fill="var(--wood-dark)"/>
      <rect x="285" y="537" width="391" height="23" rx="11" fill="var(--wood)"/>
      <rect x="287" y="537" width="386" height="8" rx="4" fill="var(--wood-light)"/>
      <rect x="323" y="518" width="90" height="17" rx="4" fill="var(--book-rose)"/>
      <path d="M330 522h76v8h-76" fill="var(--paper)"/><rect x="316" y="501" width="92" height="16" rx="4" fill="var(--book-green)"/>
      <path d="M324 505h78v8h-78" fill="var(--paper)"/>
      <g class="cozy-tea">
        <ellipse cx="442" cy="534" rx="29" ry="4" fill="var(--wood-dark)" opacity=".3"/>
        <path d="M458 505h7a10 10 0 0 1 0 20h-8" stroke="var(--mug)" stroke-width="6" fill="none"/>
        <path d="M422 498h36v24a12 12 0 0 1-12 12h-12a12 12 0 0 1-12-12Z" fill="var(--mug)"/>
        <ellipse cx="440" cy="499" rx="18" ry="4" fill="var(--tea)"/>
        <g class="cozy-steam" fill="none" stroke="var(--steam)" stroke-width="3" stroke-linecap="round"><path d="M433 481c-10-12 8-15 1-28"/><path d="M446 483c-8-9 7-14 2-24"/></g>
      </g>
      <g class="cozy-cat" role="button" tabindex="0" aria-label="摸摸猫咪">
        <ellipse cx="573" cy="534" rx="62" ry="5" fill="var(--wood-dark)" opacity=".22"/>
        <!-- A low, continuous shoulder/back silhouette with the head resting on paws. -->
        <path class="cozy-cat-body" d="M535 525C533 514 540 505 552 502C568 497 590 501 600 511C606 517 608 524 602 528C591 534 562 533 546 532Q537 531 535 525Z" fill="var(--cat)"/>
        <!-- The near haunch is a subtle fold, not a separate lump. -->
        <path d="M589 513C580 509 576 516 579 523" fill="none" stroke="var(--cat-tail)" stroke-width="1.5" stroke-linecap="round" opacity=".55"/>
        <!-- The tail grows from the rump and tapers as it curls toward the paws. -->
        <path class="cozy-cat-tail" d="M603 517C611 517 615 523 610 529C603 537 579 535 563 532C560 531 559 529 561 528C563 527 568 529 573 529C587 531 602 530 603 526C604 524 600 523 600 521C600 519 601 518 603 517Z" fill="var(--cat-tail)"/>
        <!-- Small tucked paws support the head without forming a flat base. -->
        <path d="M541 527C545 526 550 527 552 530C554 534 550 535 547 535L541 534.8Q536 534 537 532Z" fill="var(--cat-paw)"/>
        <path d="M526 527C530 525.5 536 527 538 530C540 533.5 537 535.5 533 535.7L526 535.7C523 535.7 520.5 534.5 521 532Q522 529 526 527Z" fill="var(--cat-paw)"/>
        <path d="M525 532q.5 1 .2 2M529 532q.5 1 .2 2M544 531.5q.5 .8 .2 1.7M548 531.5q.5 .8 .2 1.7M538 531.5q.7 1.8-1 3" fill="none" stroke="var(--cat-ink)" stroke-width=".65" stroke-linecap="round" opacity=".3"/>
        <g class="cozy-cat-head">
          <path d="M515 508L514 493Q514 490 517 492L526 499Q534 497 542 500L550 494Q553 492 552 496L550 510C553 519 545 525 535 525C525 525 515 521 515 508Z" fill="var(--cat-face)"/>
          <path d="M518 496L519 506L524 501Z M549 498L543 503L548 507Z" fill="var(--cat-ear)"/>
          <path class="cozy-eyes-closed" d="M521 514q3 3 6 0m12 0q3 3 6-1" stroke="var(--cat-ink)" stroke-width="1.7" fill="none" stroke-linecap="round"/>
          <g class="cozy-eyes-open">
            <ellipse cx="524" cy="513.5" rx="2.8" ry="3" fill="#eee4c3"/><ellipse cx="542" cy="513" rx="2.8" ry="3" fill="#eee4c3"/>
            <ellipse cx="524" cy="513.5" rx="1.2" ry="2.5" fill="var(--cat-ink)"/><ellipse cx="542" cy="513" rx="1.2" ry="2.5" fill="var(--cat-ink)"/>
            <circle cx="524.6" cy="512.5" r=".6" fill="#fff9ea"/><circle cx="542.6" cy="512" r=".6" fill="#fff9ea"/>
          </g>
          <path d="M531 519Q533 518 535 519L533 521Z" fill="var(--cat-ink)"/>
          <path d="M533 521v1" stroke="var(--cat-ink)" stroke-width="1" stroke-linecap="round"/>
        </g>
        <rect class="cozy-hit" x="499" y="470" width="140" height="67" rx="14"/>
      </g>
      <!-- Rounded leaves, with one gentle sway shared by the plant. -->
      <g class="cozy-plant">
        <path d="M191 586Q196 466 167 410M192 541Q232 508 239 464M188 509Q146 484 139 459" fill="none" stroke="var(--leaf-dark)" stroke-width="5" stroke-linecap="round"/>
        <ellipse cx="162" cy="422" rx="19" ry="38" transform="rotate(-28 162 422)" fill="var(--leaf-dark)"/>
        <ellipse cx="190" cy="460" rx="19" ry="34" transform="rotate(25 190 460)" fill="var(--leaf-light)"/>
        <ellipse cx="140" cy="463" rx="19" ry="34" transform="rotate(-48 140 463)" fill="var(--leaf-light)"/>
        <ellipse cx="231" cy="479" rx="21" ry="37" transform="rotate(32 231 479)" fill="var(--leaf-dark)"/>
        <ellipse cx="164" cy="517" rx="20" ry="34" transform="rotate(-54 164 517)" fill="var(--leaf-dark)"/>
        <ellipse cx="215" cy="537" rx="18" ry="31" transform="rotate(50 215 537)" fill="var(--leaf-light)"/>
      </g>
      <ellipse cx="191" cy="663" rx="47" ry="8" fill="var(--floor-shadow)"/>
      <path d="M153 574h77l-9 65q-2 18-29 18t-29-18Z" fill="var(--pot)"/>
      <rect x="148" y="569" width="87" height="15" rx="6" fill="var(--pot-rim)"/>
      <path d="M171 598l4 35" stroke="var(--pot-rim)" stroke-width="5" stroke-linecap="round"/>
      <!-- Two books resting on the rug. -->
      <g transform="rotate(-7 514 672)"><rect x="468" y="650" width="80" height="17" rx="3" fill="var(--book-green)"/><path d="M477 654h67v9h-67" fill="var(--paper)"/><rect x="480" y="634" width="79" height="15" rx="3" fill="var(--book-rose)"/><path d="M486 638h68v7h-68" fill="var(--paper)"/></g>
    </svg>
  </div>
  <div class="moon-copy">
    <p class="cozy-eyebrow"><span></span> A LITTLE CORNER OF MY WORLD</p>
    <h1 class="moon-slogan"><span id="subtitle" data-typed-text="<%= subtitle %>"><%= subtitle %></span></h1>
  </div>
  <a class="moon-scroll" href="#board" aria-label="向下浏览文章"><span aria-hidden="true">↓</span></a>
</div>
<script src="<%- cover_asset('js/moon-cover.js') %>" defer></script>
